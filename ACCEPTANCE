#!/usr/bin/env bash
set -euo pipefail
repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec python3 -B - "$repo_dir" <<'PY'
import importlib.util
import io
import sys
import unittest
from pathlib import Path

root = Path(sys.argv[1])
stage = "DEMO"

def require(condition, message):
    if not condition:
        raise AssertionError(message)

try:
    spec = importlib.util.spec_from_file_location(
        "acceptance_tests", str(root / "tests" / "test_facts_lint.py"))
    tests = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(tests)
    demo = tests.run_cli(root / "examples")
    require(demo.returncode == 0 and demo.stdout == "facts=4 files=1 errors=0\n"
            and demo.stderr == "", "expected demo exit 0 and counts 4/1/0")
    print("EVIDENCE_FACTS DEMO facts=4 files=1 errors=0", flush=True)

    stage = "REJECTS"
    expected_rules = {
        "malformed-line", "malformed-address", "domain-mismatch", "duplicate-address",
        "duplicate-field", "missing-field", "empty-field", "bad-probe", "bad-owner",
        "bad-kind", "bad-date", "bad-duration", "bad-confidence", "unknown-field",
        "stray-segment", "empty-relation", "unresolved-target",
    }
    fixtures = tests.INVALID_FIXTURES
    require(len(fixtures) == 42 and len({case for case, rule, text in fixtures}) == 42,
            "expected 42 distinct rejection fixtures")
    require({rule for case, rule, text in fixtures} == expected_rules
            and len(expected_rules) == 17, "expected 17 distinct rule IDs")
    for case, rule, text in fixtures:
        tests.check_rejection(case, rule, text)
    print("EVIDENCE_FACTS REJECTS rules=17 all-rejected-for-the-right-reason=yes", flush=True)

    stage = "TESTS"
    suite = unittest.defaultTestLoader.loadTestsFromModule(tests)
    result = unittest.TextTestRunner(stream=io.StringIO(), verbosity=0).run(suite)
    require(result.testsRun == 73 and not result.failures and not result.errors
            and not result.skipped,
            "run={} failures={} errors={} skips={}".format(
                result.testsRun, len(result.failures), len(result.errors), len(result.skipped)))
    print("EVIDENCE_FACTS TESTS run=73 failures=0 errors=0 skips=0", flush=True)
    print("EVIDENCE_FACTS ACCEPTANCE PASS", flush=True)
except Exception as error:
    # Report the failed assertion without dumping fixture text or a traceback.
    message = str(error) if isinstance(error, AssertionError) else type(error).__name__
    print("EVIDENCE_FACTS {} FAIL: {}".format(stage, message), file=sys.stderr)
    sys.exit(1)
PY
